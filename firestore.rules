rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared "presente no local" status (falta/pronto, opcional - pode ser
    // ausente para "nao marcado") plus a free-text guarnicao (officer names),
    // tracked SEPARATELY per turno (1 and 2 use different officers) - hence
    // situacao1/guarnicao1/updatedAt1 and situacao2/guarnicao2/updatedAt2.
    // autor1/autor2: lightweight per-device identification (name + graduação,
    // not a login for the battalion links - just an attribution label picked by
    // the client and sent along with every write) so multiple officers
    // sharing the same battalion link can tell who last touched a location.
    // Public read (anyone with the map link can see current status). WRITING needs a
    // login (since 2026-10-03 the battalion links are view-only), and only these fields
    // with validated shapes can be written - no other collection or field can be touched.
    // Signed-in users (the officers with a personal login, see index.html USERS) may
    // only write docs whose bairro is on their own list below — enforced HERE, not just
    // in the UI. Requests with no sign-in cannot write at all.
    function areaOf(email){
      return {
      'pedrosa@cpc1.app': ['1|SACRAMENTA', '1|TELEGRAFO SEM FIO'],
      'thais@cpc1.app': ['1|MARCO'],
      'sales@cpc1.app': ['1|PEDREIRA'],
      'amanajas@cpc1.app': ['2|CAMPINA', '2|CIDADE VELHA', '2|UMARIZAL', '2|REDUTO'],
      'karyn@cpc1.app': ['2|SAO BRAS', '2|FATIMA', '2|NAZARE', '2|BATISTA CAMPOS'],
      'tatiane@cpc1.app': ['20|CONDOR', '20|CREMACAO', '20|JURUNAS'],
      'anjos@cpc1.app': ['27|MARAMBAIA', '27|CASTANHEIRA'],
      'sidney@cpc1.app': ['27|CURIO UTINGA', '27|SOUZA'],
      'noronha@cpc1.app': ['37|GUAMA', '37|UNIVERSITARIO'],
      'vanderlei@cpc1.app': ['37|TERRA FIRME', '37|CANUDOS']
      }.get(email, []);
    }
    function validShape(){
      let d = request.resource.data;
      return d.keys().hasOnly(
          ['situacao1', 'guarnicao1', 'updatedAt1', 'autor1', 'situacao2', 'guarnicao2', 'updatedAt2', 'autor2'])
        && (!('situacao1' in d) || d.situacao1 in ['falta', 'pronto'])
        && (!('situacao2' in d) || d.situacao2 in ['falta', 'pronto'])
        && (!('guarnicao1' in d) || (d.guarnicao1 is string && d.guarnicao1.size() <= 500))
        && (!('guarnicao2' in d) || (d.guarnicao2 is string && d.guarnicao2.size() <= 500))
        && (!('autor1' in d) || (d.autor1 is string && d.autor1.size() <= 100))
        && (!('autor2' in d) || (d.autor2 is string && d.autor2.size() <= 100));
    }
    // The administrator (admin@cpc1.app) may write any bairro and is the only one who can delete.
    function isAdmin(){
      return request.auth != null && request.auth.token.email == 'admin@cpc1.app';
    }
    // Access switch per officer, toggled by the admin in "Controle de acessos":
    // config/acessos = { pedrosa: true, thais: false, ... }. A missing doc or key
    // counts as OFF, so every personal login stays switched off until the admin
    // turns it on. Their accounts and areas are kept; only writing is blocked.
    function loginEnabled(){
      let path = /databases/$(database)/documents/config/acessos;
      return exists(path)
        && get(path).data.get(request.auth.token.email.split('@')[0], false) == true;
    }
    function inMyArea(docId){
      return request.auth != null && request.auth.token.email != null
        && docId.split('__')[0] in areaOf(request.auth.token.email)
        && loginEnabled();
    }
    match /status/{docId} {
      allow read: if true;
      allow create, update: if validShape() && request.auth != null && (isAdmin() || inMyArea(docId));
      allow delete: if isAdmin();
    }
    // Change history: one entry per Situação/Guarnição change, written by the app in the
    // same batch as the status write. Append-only — nobody (not even the admin) can edit
    // or delete an entry. Same who-may-write-where rule as the status docs themselves.
    function validHist(){
      let d = request.resource.data;
      return d.keys().hasOnly(['local', 'turno', 'acao', 'texto', 'autor', 'quando'])
        && d.local is string && d.local.size() <= 200
        && d.turno in ['1', '2', 'ambos']
        && d.acao in ['falta', 'pronto', 'desmarcado', 'guarnicao', 'apagado']
        && d.texto is string && d.texto.size() <= 500
        && d.autor is string && d.autor.size() <= 100
        && d.quando == request.time;
    }
    match /historico/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && (isAdmin() || inMyArea(request.resource.data.local))
        && validHist();
      allow update, delete: if false;
    }
    match /config/acessos {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['pedrosa', 'thais', 'sales', 'amanajas', 'karyn',
             'tatiane', 'anjos', 'sidney', 'noronha', 'vanderlei'])
        && request.resource.data.values().hasOnly([true, false]);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
